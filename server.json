{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Obelinf/mcp",
  "title": "Obelinf",
  "description": "MCP server for Obelinf, the network documentation platform. Sites, racks, devices, IPs, VLANs.",
  "version": "1.0.1",
  "websiteUrl": "https://obelinf.com",
  "icons": [
    {
      "src": "https://obelinf.com/logo-512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    }
  ],
  "repository": {
    "url": "https://github.com/Obelinf/mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.obelinf.com/mcp?org={orgSlug}",
      "variables": {
        "orgSlug": {
          "description": "Your Obelinf organization slug, as shown in your dashboard URL",
          "isRequired": true
        }
      }
    }
  ]
}
